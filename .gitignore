# Secretos
.env
*.env
!.env.example

# Entornos y cachés
.venv*/
__pycache__/
.ipynb_checkpoints/
*.pyc

# Datos pesados: viven en la zona de trabajo (config.yaml), nunca en el repo
*.mp4
*.mov
*.avi
*.mkv
*.npz
*.npy
*.zip
!datos_derivados/vv/prueba_etiquetas_corregidas.zip
*.cache
runs/
datos/

# Pesos: en git solo los detectores publicados en modelos/<nombre>/ (ver modelos/README.md)
*.pt
*.pth
!modelos/*/best.pt

# Imágenes de datasets (las figuras de resultados sí se versionan)
datos_derivados/**/*.jpg
datos_derivados/**/*.png

# Figuras con cuadros de video (Adobe Stock / YouTube): no se redistribuyen (D-20).
# Los notebooks las regeneran en runs/; en resultados/ solo van trazos y gráficas sin fondo.
*_fondo.png
tira_*.jpg
resultados/**/trayectoria_*.png
trayectorias_comparacion.png
