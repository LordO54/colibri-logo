# Secretos
.env
*.env
!.env.example

# Entornos y cachés
.venv*/
__pycache__/
.ipynb_checkpoints/
*.pyc
*.egg-info/

# Lo tuyo: videos, datasets y resultados
videos/*
!videos/.gitkeep
datasets/*
!datasets/.gitkeep
salidas/*
